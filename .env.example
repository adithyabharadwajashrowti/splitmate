# Copy this file to .env and fill in from Supabase → Project Settings → API
# The anon / publishable key is SAFE to use in the browser (RLS protects your data).
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: shows a "Try the live demo" button on the login page that signs into this demo account
# VITE_DEMO_EMAIL=rahul.demo@example.com
# VITE_DEMO_PASSWORD=SplitMate@Demo1
